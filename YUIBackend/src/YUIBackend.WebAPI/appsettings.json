{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*",
  "Blockchain": {
    "RpcUrl": "http://127.0.0.1:8545",
    "ChainId": 31337,
    "ContractAddress": "",
    "PrivateKey": ""
  },
  "Mqtt": {
    "Host": "127.0.0.1",
    "Port": 1883,
    "ClientId": "teletip-api",
    "Username": "",
    "Password": "",
    "TopicFilter": "teletip/tenants/+/patients/+/measurements"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:7b",
    "TimeoutSeconds": 120,
    "MaxInputMeasurements": 100
  },
  "TenantSettings": {
    "Tenants": [
      {
        "Id": "tenant-1",
        "Name": "Şirket A"
      },
      {
        "Id": "tenant-2",
        "Name": "Şirket B"
      }
    ]
  },
  "Jwt": {
    "Issuer": "Me",
    "Audience": "My Projects"
  }
}